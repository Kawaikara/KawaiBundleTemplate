{
  "name": "kawaikara-bundle-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.0",
  "kawaikara": {
    "development": {
      "outputDirectory": ".kawaikara/development"
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "pnpm clean && tsup && node scripts/package.mjs",
    "postinstall": "node scripts/sync-schemas.mjs",
    "schemas:sync": "node scripts/sync-schemas.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@kawaikara/site-api": "https://github.com/Kawaikara/kawai-site-api/releases/download/v1.0.0/kawaikara-site-api-1.0.0.tgz",
    "archiver": "^7.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  }
}
