{
  "schemaVersion": 1,
  "id": "example.google",
  "name": "Google",
  "description": "Opens Google and demonstrates Provider and Plugin panels.",
  "version": "1.0.0",
  "apiVersion": 1,
  "main": "Provider.js",
  "permissions": ["navigation", "plugin-view"],
  "contributes": {
    "address": { "hosts": ["google.com"] },
    "shortcut": { "defaultKey": "CommandOrControl+Alt+G" },
    "locale": {
      "resource": "locale.json",
      "supportedLocales": ["en-US", "ko-KR", "ja-JP"],
      "defaultLocale": "inherit"
    },
    "menu": {
      "category": "Examples",
      "order": 10
    }
  },
  "plugins": ["Plugins/PanelGallery"]
}
